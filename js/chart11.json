{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": 760,
  "height": 500,
  "data": {
    "url": "data/nvis_mvg_change.csv"
  },
  "transform": [
    {
      "filter": "datum.pre1750_mha >= 3"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "pre1750_mha",
          "as": "max_pre"
        },
        {
          "op": "max",
          "field": "extant_mha",
          "as": "max_ext"
        },
        {
          "op": "max",
          "field": "absolute_change_mha",
          "as": "max_abs"
        },
        {
          "op": "max",
          "field": "retention_pct",
          "as": "max_ret"
        }
      ]
    },
    {
      "calculate": "datum.pre1750_mha/datum.max_pre*100",
      "as": "Historical area"
    },
    {
      "calculate": "datum.extant_mha/datum.max_ext*100",
      "as": "Extant area"
    },
    {
      "calculate": "datum.absolute_change_mha/datum.max_abs*100",
      "as": "Absolute change"
    },
    {
      "calculate": "min(datum.retention_pct,140)/140*100",
      "as": "Area ratio"
    },
    {
      "fold": [
        "Historical area",
        "Extant area",
        "Absolute change",
        "Area ratio"
      ],
      "as": [
        "metric",
        "score"
      ]
    }
  ],
  "mark": {
    "type": "line",
    "strokeWidth": 2,
    "opacity": 0.48
  },
  "encoding": {
    "x": {
      "field": "metric",
      "type": "ordinal",
      "sort": [
        "Historical area",
        "Extant area",
        "Absolute change",
        "Area ratio"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 11
      }
    },
    "y": {
      "field": "score",
      "type": "quantitative",
      "title": "Normalised score (0\u2013100)",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "detail": {
      "field": "mvg_name"
    },
    "color": {
      "field": "family",
      "type": "nominal",
      "title": "Vegetation family",
      "scale": {
        "domain": [
          "Rainforest",
          "Eucalypt forest & woodland",
          "Acacia",
          "Other forest & woodland",
          "Shrubland",
          "Grassland",
          "Other native vegetation"
        ],
        "range": [
          "#174C3A",
          "#4F8A5B",
          "#8AAE68",
          "#6F9C86",
          "#B59B69",
          "#D2BE7F",
          "#9BAE9C"
        ]
      }
    },
    "opacity": {
      "condition": {
        "param": "hover",
        "value": 0.95
      },
      "value": 0.35
    },
    "tooltip": [
      {
        "field": "mvg_name",
        "title": "Major Vegetation Group"
      },
      {
        "field": "family",
        "title": "Vegetation family"
      },
      {
        "field": "pre1750_mha",
        "type": "quantitative",
        "title": "Pre-1750 (Mha)",
        "format": ".1f"
      },
      {
        "field": "extant_mha",
        "type": "quantitative",
        "title": "Extant (Mha)",
        "format": ".1f"
      },
      {
        "field": "absolute_change_mha",
        "type": "quantitative",
        "title": "Absolute change (Mha)",
        "format": ".1f"
      },
      {
        "field": "retention_pct",
        "type": "quantitative",
        "title": "Extant / pre-1750 (%)",
        "format": ".1f"
      }
    ]
  },
  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "on": "pointerover",
        "clear": "pointerout",
        "fields": [
          "mvg_name"
        ]
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#29483B",
      "titleColor": "#29483B",
      "gridColor": "#E7EAE5",
      "domain": false
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#29483B",
      "titleColor": "#29483B"
    },
    "view": {
      "stroke": null
    }
  }
}