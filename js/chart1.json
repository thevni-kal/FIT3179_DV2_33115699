{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Annotated hierarchical radial partition showing Australia's mapped land and the composition of its forest share. The two smallest outer-ring forest categories use a minimum display width for legibility; labels and tooltips report the exact values.",
  "width": 820,
  "height": 640,
  "background": null,
  "layer": [
    {
      "data": {
        "url": "data/chart1_inner_from_abares.csv"
      },
      "params": [
        {
          "name": "innerHover",
          "select": {
            "type": "point",
            "fields": [
              "category"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "arc",
        "innerRadius": 102,
        "outerRadius": 162,
        "stroke": "#FFFFFF",
        "strokeWidth": 4
      },
      "encoding": {
        "theta": {
          "field": "area_ha",
          "type": "quantitative",
          "stack": true
        },
        "order": {
          "field": "order",
          "type": "ordinal"
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Forest",
              "Non-forest"
            ],
            "range": [
              "#0B5942",
              "#D7D6D0"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "param": "innerHover",
            "value": 1
          },
          "value": 0.98
        },
        "tooltip": [
          {
            "field": "category",
            "title": "Land classification"
          },
          {
            "field": "area_ha",
            "title": "Area (ha)",
            "format": ",.0f"
          },
          {
            "field": "share",
            "title": "Share of mapped land (%)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/chart1_outer_from_abares.csv"
      },
      "params": [
