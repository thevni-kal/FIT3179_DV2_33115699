        "type": "arc",
        "innerRadius": 166,
        "outerRadius": 252,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.8,
        "cornerRadius": 0
      },
      "encoding": {
        "theta": {
          "field": "display_area",
          "type": "quantitative",
          "stack": true
        },
        "order": {
          "field": "order",
          "type": "ordinal"
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
