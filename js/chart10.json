{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": 610,
  "height": 610,
  "data": {
    "url": "data/nvis_mvg_change.csv"
  },
  "transform": [
    {
      "filter": "datum.pre1750_mha >= 3"
    },
    {
      "calculate": "min(datum.retention_pct, 140)",
      "as": "retention_capped"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 95,
        "stroke": "#F6F3EC",
        "strokeWidth": 1.5
      },
      "encoding": {
        "theta": {
          "field": "retention_capped",
          "type": "quantitative",
          "stack": false,
          "scale": {
            "domain": [
              0,
              140
            ]
          }
        },
        "radius": {
          "field": "mvg_name",
          "type": "ordinal",
          "sort": {
            "field": "retention_pct",
            "order": "ascending"
          },
          "scale": {
            "rangeMin": 110,
            "rangeMax": 285
          }
        },
        "color": {
          "field": "family",
          "type": "nominal",
          "title": "Vegetation family",
          "scale": {
            "domain": [
              "Rainforest",
              "Eucalypt forest & woodland",
              "Acacia",
              "Other forest & woodland",
              "Shrubland",
              "Grassland",
              "Other native vegetation"
            ],
            "range": [
              "#174C3A",
              "#4F8A5B",
              "#8AAE68",
              "#6F9C86",
              "#B59B69",
              "#D2BE7F",
              "#9BAE9C"
            ]
          }
        },
        "tooltip": [
          {
            "field": "mvg_name",
            "title": "Major Vegetation Group"
          },
          {
            "field": "retention_pct",
            "type": "quantitative",
            "title": "Extant / pre-1750 (%)",
            "format": ".1f"
          },
          {
            "field": "pre1750_mha",
            "type": "quantitative",
            "title": "Pre-1750 (Mha)",
            "format": ".1f"
          },
          {
            "field": "extant_mha",
            "type": "quantitative",
            "title": "Extant (Mha)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "v": 100
          }
        ]
      },
      "mark": {
        "type": "arc",
        "innerRadius": 94,
        "outerRadius": 286,
        "fill": null,
        "stroke": "#173F30",
        "strokeDash": [
          5,
          4
        ],
        "strokeWidth": 1
      },
      "encoding": {
        "theta": {
          "field": "v",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              140
            ]
          }
        }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#29483B",
      "titleColor": "#29483B",
      "gridColor": "#E7EAE5",
      "domain": false
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#29483B",
      "titleColor": "#29483B"
    },
    "view": {
      "stroke": null
    }
  }
}