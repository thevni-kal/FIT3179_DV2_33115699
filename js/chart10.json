{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": 720,
  "height": {"step": 27},
  "data": {"url": "data/nvis_mvg_change.csv"},
  "transform": [
    {"filter": "datum.pre1750_mha >= 1 && datum.mvg != 24 && datum.mvg != 25 && datum.mvg != 26 && datum.mvg != 27 && datum.mvg != 28 && datum.mvg != 29 && datum.mvg != 99"},
    {"calculate": "((datum.extant_mha - datum.pre1750_mha) / datum.pre1750_mha) * 100", "as": "pct_change"},
    {"calculate": "abs(datum.pct_change)", "as": "abs_pct_change"},
    {"calculate": "datum.pct_change < 0 ? 'Below historical total' : 'Above historical total'", "as": "direction"}
  ],
  "layer": [
    {"mark":{"type":"rule","stroke":"#8EA097","strokeWidth":1.4},"encoding":{"x":{"datum":0}}},
    {"mark":{"type":"bar","cornerRadiusEnd":3,"size":17},"encoding":{
      "y":{"field":"mvg_name","type":"nominal","sort":{"field":"pct_change","order":"ascending"},"axis":{"title":null,"labelLimit":210,"ticks":false}},
      "x":{"field":"pct_change","type":"quantitative","title":"Difference from estimated pre-1750 area (%)","scale":{"domain":[-100,200]},"axis":{"values":[-100,-50,0,50,100,150,200],"labelExpr":"datum.value + '%'"}},
      "color":{"field":"direction","type":"nominal","title":null,"scale":{"domain":["Below historical total","Above historical total"],"range":["#B9876A","#24634D"]}},
      "tooltip":[{"field":"mvg_name","title":"Major Vegetation Group"},{"field":"family","title":"Vegetation family"},{"field":"pct_change","type":"quantitative","title":"Difference from historical (%)","format":"+.1f"},{"field":"pre1750_mha","type":"quantitative","title":"Pre-1750 area (Mha)","format":".1f"},{"field":"extant_mha","type":"quantitative","title":"Extant area (Mha)","format":".1f"}]
    }}
  ],
  "config":{"font":"DM Sans","axis":{"labelColor":"#29483B","titleColor":"#29483B","gridColor":"#E7EAE5","domain":false},"legend":{"labelColor":"#29483B","titleColor":"#29483B","orient":"bottom"},"view":{"stroke":null}}
}
