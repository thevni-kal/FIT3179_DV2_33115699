{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Proportional-symbol map of commercial plantation forest area by state and territory.",
  "background": null,
  "width": 900,
  "height": 610,
  "projection": {
    "type": "mercator",
    "center": [
      134.5,
      -28
    ],
    "scale": 860,
    "translate": [
      450,
      300
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1F2EC",
        "stroke": "#1F2F28",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "data/plantation_state_display.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number",
            "plantation_ha": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "color": "#2E6A52",
        "opacity": 0.72,
        "stroke": "#173D2E",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "plantation_ha",
          "type": "quantitative",
          "title": "Commercial plantation area (ha)",
          "scale": {
            "range": [
              70,
              2200
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              50000,
              200000,
              400000
            ],
            "format": ".2s"
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State / territory"
          },
          {
            "field": "plantation_ha",
            "type": "quantitative",
            "title": "Commercial plantation (ha)",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/plantation_state_display.csv",
        "format": {
          "type": "csv",
          "parse": {
            "label_longitude": "number",
            "label_latitude": "number"
          }
        }
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 800,
        "color": "#173D2E",
        "stroke": "#FFFFFF",
        "strokeWidth": 3
      },
      "encoding": {
        "longitude": {
          "field": "label_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        }
      }
    },
    {
      "data": {
        "url": "data/plantation_state_display.csv",
        "format": {
          "type": "csv",
          "parse": {
            "label_longitude": "number",
            "label_latitude": "number"
          }
        }
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 800,
        "color": "#173D2E"
      },
      "encoding": {
        "longitude": {
          "field": "label_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#334B40",
      "titleColor": "#173D2E"
    }
  }
}