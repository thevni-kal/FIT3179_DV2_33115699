{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 760,
  "height": 430,
  "params": [
    {
      "name": "forestCategory",
      "value": "All forest categories",
      "bind": {
        "input": "select",
        "options": [
          "All forest categories",
          "Native forest",
          "Commercial plantation",
          "Other forest"
        ],
        "name": "Show: "
      }
    }
  ],
  "data": {
    "url": "data/chart3_treemap_layout.csv"
  },
  "transform": [
    {
      "filter": "datum.selection === forestCategory"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              760
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              430
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y2"
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Native forest",
              "Commercial plantation",
              "Other forest"
            ],
            "range": [
              "#197A69",
              "#E0874B",
              "#6178B8"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "labelFontSize": 15,
            "titleFontSize": 16,
            "title": "Forest category"
          }
        },
        "tooltip": [
          {
            "field": "type",
            "title": "Forest type"
          },
          {
            "field": "category",
            "title": "Category"
          },
          {
            "field": "area_mha",
            "title": "Area (million ha)",
            "format": ".2f"
          },
          {
            "field": "percent",
            "title": "Share of all mapped forest (%)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.label !== \"\""
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 16,
        "fontWeight": "bold",
        "color": "white",
        "baseline": "middle",
        "align": "center",
        "lineBreak": "\\n",
        "lineHeight": 19
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              760
            ]
          },
          "axis": null
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              430
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.area_label !== \"\""
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "normal",
        "color": "white",
        "baseline": "middle",
        "dy": 27
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              760
            ]
          },
          "axis": null
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              430
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "area_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "DM Sans"
  }
}
