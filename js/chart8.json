{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": 760,
  "height": 500,
  "data": {
    "url": "data/nvis_mvg_change.csv"
  },
  "transform": [
    {
      "calculate": "datum.retention_pct < 50 ? 'Less than 50%' : datum.retention_pct < 75 ? '50\u201375%' : datum.retention_pct < 100 ? '75\u2013100%' : '100% or more'",
      "as": "retention_band"
    },
    {
      "calculate": "datum.absolute_change_mha < 2 ? 'Under 2 Mha' : datum.absolute_change_mha < 10 ? '2\u201310 Mha' : datum.absolute_change_mha < 25 ? '10\u201325 Mha' : '25+ Mha'",
      "as": "change_band"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 7,
        "stroke": "#F6F3EC",
        "strokeWidth": 4
      },
      "encoding": {
        "x": {
          "field": "retention_band",
          "type": "ordinal",
          "sort": [
            "Less than 50%",
            "50\u201375%",
            "75\u2013100%",
            "100% or more"
          ],
          "axis": {
            "title": "Historical mapped extent remaining",
            "labelAngle": 0
          }
        },
        "y": {
          "field": "change_band",
          "type": "ordinal",
          "sort": [
            "25+ Mha",
            "10\u201325 Mha",
            "2\u201310 Mha",
            "Under 2 Mha"
          ],
          "axis": {
            "title": "Absolute change in mapped area"
          }
        },
        "color": {
          "aggregate": "count",
          "type": "quantitative",
          "title": "Number of groups",
          "scale": {
            "range": [
              "#EDF2ED",
              "#174C3A"
            ]
          }
        },
        "tooltip": [
          {
            "aggregate": "count",
            "type": "quantitative",
            "title": "Vegetation groups"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 0.88,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "retention_band",
          "type": "ordinal",
          "sort": [
            "Less than 50%",
            "50\u201375%",
            "75\u2013100%",
            "100% or more"
          ]
        },
        "y": {
          "field": "change_band",
          "type": "ordinal",
          "sort": [
            "25+ Mha",
            "10\u201325 Mha",
            "2\u201310 Mha",
            "Under 2 Mha"
          ]
        },
        "xOffset": {
          "field": "family"
        },
        "size": {
          "field": "pre1750_mha",
          "type": "quantitative",
          "title": "Historical area (Mha)",
          "scale": {
            "range": [
              35,
              650
            ]
          }
        },
        "color": {
          "field": "family",
          "type": "nominal",
          "title": "Vegetation family",
          "scale": {
            "domain": [
              "Rainforest",
              "Eucalypt forest & woodland",
              "Acacia",
              "Other forest & woodland",
              "Shrubland",
              "Grassland",
              "Other native vegetation"
            ],
            "range": [
              "#174C3A",
              "#4F8A5B",
              "#8AAE68",
              "#6F9C86",
              "#B59B69",
              "#D2BE7F",
              "#9BAE9C"
            ]
          }
        },
        "tooltip": [
          {
            "field": "mvg_name",
            "title": "Major Vegetation Group"
          },
          {
            "field": "family",
            "title": "Vegetation family"
          },
          {
            "field": "pre1750_mha",
            "type": "quantitative",
            "title": "Pre-1750 (Mha)",
            "format": ".1f"
          },
          {
            "field": "extant_mha",
            "type": "quantitative",
            "title": "Extant (Mha)",
            "format": ".1f"
          },
          {
            "field": "retention_pct",
            "type": "quantitative",
            "title": "Area ratio (%)",
            "format": ".1f"
          },
          {
            "field": "absolute_change_mha",
            "type": "quantitative",
            "title": "Absolute change (Mha)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#29483B",
      "titleColor": "#29483B",
      "gridColor": "#E7EAE5",
      "domain": false
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#29483B",
      "titleColor": "#29483B"
    },
    "view": {
      "stroke": null
    }
  }
}