{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Dot-density map of Australian mapped forest area by dominant forest type. One dot is approximately 0.5 million hectares; positions are illustrative within each jurisdiction.",
  "background": null,
  "width": 900,
  "height": 610,
  "projection": {
    "type": "mercator",
    "center": [
      134.5,
      -28
    ],
    "scale": 860,
    "translate": [
      450,
      300
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1F2EC",
        "stroke": "#1F2F28",
        "strokeWidth": 1.15
      }
    },
    {
      "data": {
        "url": "data/forest_type_dot_density.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number",
            "dot_mha": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "size": 58,
        "opacity": 0.86,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.45
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "forest_type",
          "type": "nominal",
          "title": "Forest type represented by each dot",
          "scale": {
            "domain": [
              "Eucalypt Medium Woodland",
              "Eucalypt Medium Open",
              "Acacia",
              "Eucalypt Mallee Woodland",
              "Eucalypt Low Woodland",
              "Other forest types"
            ],
            "range": [
              "#174C3A",
              "#4F8A5B",
              "#7EA26B",
              "#A5B77B",
              "#C5A85C",
              "#9BAE9C"
            ]
          },
          "legend": {
            "orient": "bottom",
            "columns": 3,
            "labelLimit": 220,
            "symbolSize": 90
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "forest_type",
            "title": "Forest type"
          },
          {
            "field": "dot_mha",
            "title": "Approx. area represented (Mha)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    }
  }
}