{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Dot-density map of current mapped forest area by Australian state and territory. Each dot represents approximately 0.5 million hectares; positions are illustrative within each jurisdiction rather than exact forest locations.",
  "background": null,
  "width": 760,
  "height": 560,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -28
    ],
    "scale": 650,
    "translate": [
      380,
      280
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1F2EC",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.4
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.STE_NAME21",
            "type": "nominal",
            "title": "State / territory"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/forest_dot_density.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number",
            "dot_mha": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "size": 42,
        "opacity": 0.72,
        "color": "#2F7457",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.35
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "dot_mha",
            "type": "quantitative",
            "title": "Area represented (Mha)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    }
  }
}