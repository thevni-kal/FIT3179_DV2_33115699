{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Dot-density map of Australian mapped forest area by dominant forest type. One dot is approximately 0.5 million hectares; positions are illustrative within each jurisdiction.",
  "background": null,
  "width": 760,
  "height": 530,
  "projection": {
    "type": "mercator",
    "center": [
      134.5,
      -28
    ],
    "scale": 690,
    "translate": [
      380,
      255
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1F2EC",
        "stroke": "#1F2F28",
        "strokeWidth": 1.15
      }
    },
    {
      "data": {
        "url": "data/forest_type_dot_density.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number",
            "dot_mha": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "size": 95,
        "opacity": 0.86,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.45
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "forest_type",
          "type": "nominal",
          "title": "Forest type represented by each dot",
          "scale": {
            "domain": [
              "Eucalypt Medium Woodland",
              "Eucalypt Medium Open",
              "Acacia",
              "Eucalypt Mallee Woodland",
              "Eucalypt Low Woodland",
              "Other forest types"
            ],
            "range": [
              "#176B99",
              "#D24F42",
              "#E1A22D",
              "#7452A3",
              "#26947B",
              "#9B5AA5"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "forest_type",
            "title": "Forest type"
          },
          {
            "field": "dot_mha",
            "title": "Approx. area represented (Mha)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "annotation": "Illustrative dots — not exact forest locations"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 12,
        "fontWeight": 700,
        "align": "left",
        "baseline": "top",
        "color": "#173D2E",
        "stroke": "#FFFFFF",
        "strokeWidth": 3,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "value": 12
        },
        "y": {
          "value": 12
        },
        "text": {
          "field": "annotation",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 16,
      "titleFontSize": 17,
      "symbolSize": 160
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    }
  }
}
