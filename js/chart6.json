{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": 760,
  "height": {
    "step": 24
  },

  "data": {
    "url": "data/nvis_mvg_change.csv"
  },

  "transform": [
    {
      "filter": "datum.pre1750_mha > 0"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#C7D2CB",
        "strokeWidth": 2
      },

      "encoding": {
        "y": {
          "field": "mvg_name",
          "type": "nominal",
          "sort": {
            "field": "pre1750_mha",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 205,
            "ticks": false
          }
        },

        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "zero": true
          },
          "axis": {
            "title": "Estimated pre-1750 mapped area (million hectares)"
          }
        },

        "x2": {
          "field": "pre1750_mha"
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 125,
        "stroke": "white",
        "strokeWidth": 1.2
      },

      "encoding": {
        "y": {
          "field": "mvg_name",
          "type": "nominal",
          "sort": {
            "field": "pre1750_mha",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 205,
            "ticks": false
          }
        },

        "x": {
          "field": "pre1750_mha",
          "type": "quantitative",
          "scale": {
            "zero": true
          },
          "axis": {
            "title": "Estimated pre-1750 mapped area (million hectares)"
          }
        },

        "color": {
          "field": "family",
          "type": "nominal",
          "title": "Vegetation family",
          "scale": {
            "domain": [
              "Rainforest",
              "Eucalypt forest & woodland",
              "Acacia",
              "Other forest & woodland",
              "Shrubland",
              "Grassland",
              "Other native vegetation"
            ],
            "range": [
              "#174C3A",
              "#4F8A5B",
              "#8AAE68",
              "#6F9C86",
              "#B59B69",
              "#D2BE7F",
              "#9BAE9C"
            ]
          }
        },

        "tooltip": [
          {
            "field": "mvg_name",
            "type": "nominal",
            "title": "Major Vegetation Group"
          },
          {
            "field": "family",
            "type": "nominal",
            "title": "Vegetation family"
          },
          {
            "field": "pre1750_mha",
            "type": "quantitative",
            "title": "Pre-1750 area (Mha)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.pre1750_mha >= 30"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#29483B"
      },

      "encoding": {
        "y": {
          "field": "mvg_name",
          "type": "nominal",
          "sort": {
            "field": "pre1750_mha",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 205,
            "ticks": false
          }
        },

        "x": {
          "field": "pre1750_mha",
          "type": "quantitative",
          "scale": {
            "zero": true
          }
        },

        "text": {
          "field": "pre1750_mha",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],

  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },

  "config": {
    "font": "DM Sans",

    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#29483B",
      "titleColor": "#29483B",
      "gridColor": "#E7EAE5",
      "domain": false
    },

    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#29483B",
      "titleColor": "#29483B",
      "orient": "bottom"
    },

    "view": {
      "stroke": null
    }
  }
}