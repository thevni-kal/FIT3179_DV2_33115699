{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Australian state and territory forest area choropleth with ranked comparison.",
  "background": null,
  "spacing": 10,
  "hconcat": [
    {
      "width": 690,
      "height": 550,
      "title": {
        "text": "Forest area across Australia",
        "subtitle": "Darker states contain more mapped forest area",
        "anchor": "start",
        "font": "DM Sans",
        "fontSize": 19,
        "fontWeight": 700,
        "color": "#103D2E",
        "subtitleFont": "DM Sans",
        "subtitleFontSize": 13,
        "subtitleColor": "#65786F",
        "offset": 14
      },
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.STE_NAME21",
          "as": "state_name"
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/chart2_state_forest_from_abares.csv"
            },
            "key": "state_name",
            "fields": [
              "forest_mha",
              "national_share"
            ]
          }
        }
      ],
      "projection": {
        "type": "mercator",
        "center": [
          134.5,
          -28.5
        ],
        "scale": 620,
        "translate": [
          345,
          275
        ]
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.6
      },
      "encoding": {
        "color": {
          "field": "forest_mha",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              52
            ],
            "range": [
              "#f1e4cf",
              "#e6bd7b",
              "#d99052",
              "#b75e50",
              "#7c3763",
              "#3e2458"
            ]
          },
          "legend": {
            "title": "Forest area (million ha)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 190,
            "gradientThickness": 10,
            "titleFont": "DM Sans",
            "titleFontSize": 10,
            "titleFontWeight": 700,
            "labelFont": "DM Sans",
            "labelFontSize": 9,
            "values": [
              0,
              10,
              20,
              30,
              40,
              50
            ],
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "forest_mha",
            "type": "quantitative",
            "title": "Forest area (million ha)",
            "format": ".2f"
          },
          {
            "field": "national_share",
            "type": "quantitative",
            "title": "Share of Australian forest (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "width": 205,
      "height": 550,
      "title": {
        "text": "State ranking",
        "subtitle": "Mapped forest area",
        "anchor": "start",
        "font": "DM Sans",
        "fontSize": 19,
        "fontWeight": 700,
        "color": "#103D2E",
        "subtitleFont": "DM Sans",
        "subtitleFontSize": 13,
        "subtitleColor": "#65786F",
        "offset": 14
      },
      "data": {
        "url": "data/chart2_state_forest_from_abares.csv"
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "cornerRadiusEnd": 4,
            "color": "#86AD77"
          },
          "encoding": {
            "y": {
              "field": "state",
              "type": "nominal",
              "sort": [
                "QLD",
                "NT",
                "WA",
                "NSW",
                "VIC",
                "SA",
                "TAS",
                "ACT"
              ],
              "axis": {
                "title": null,
                "domain": false,
                "ticks": false,
                "labelFont": "DM Sans",
                "labelFontSize": 11,
                "labelFontWeight": 700,
                "labelColor": "#314B40",
                "labelPadding": 7
              }
            },
            "x": {
              "field": "forest_mha",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  58
                ]
              },
              "axis": {
                "title": "Million hectares",
                "titleFont": "DM Sans",
                "titleFontSize": 10,
                "titleFontWeight": 600,
                "titleColor": "#61746B",
                "titlePadding": 10,
                "labelFont": "DM Sans",
                "labelFontSize": 9,
                "labelColor": "#718078",
                "values": [
                  0,
                  10,
                  20,
                  30,
                  40,
                  50
                ],
                "grid": true,
                "gridColor": "#EBECE7",
                "gridWidth": 1,
                "domain": false,
                "ticks": false
              }
            },
            "tooltip": [
              {
                "field": "state_name",
                "type": "nominal",
                "title": "State or territory"
              },
              {
                "field": "forest_mha",
                "type": "quantitative",
                "title": "Forest area (million ha)",
                "format": ".2f"
              },
              {
                "field": "national_share",
                "type": "quantitative",
                "title": "Share of Australian forest (%)",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 5,
            "font": "DM Sans",
            "fontSize": 10,
            "fontWeight": 700,
            "color": "#103D2E"
          },
          "encoding": {
            "y": {
              "field": "state",
              "type": "nominal",
              "sort": [
                "QLD",
                "NT",
                "WA",
                "NSW",
                "VIC",
                "SA",
                "TAS",
                "ACT"
              ]
            },
            "x": {
              "field": "forest_mha",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  58
                ]
              }
            },
            "text": {
              "field": "forest_mha",
              "type": "quantitative",
              "format": ".1f"
            }
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 15,
      "titleFontSize": 16
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 15,
      "titleFontSize": 16
    }
  }
}
