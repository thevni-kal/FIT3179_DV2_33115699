{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Row-normalised spatial transition matrix. Each row sums to 100% of a historical broad vegetation family.",
  "background": null,
  "width": 800,
  "height": 520,
  "data": {
    "url": "data/nvis_family_transitions.csv",
    "format": {
      "type": "csv",
      "parse": {
        "area_mha": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.area_mha > 0"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "area_mha",
          "as": "from_total_mha"
        }
      ],
      "groupby": [
        "from_family"
      ]
    },
    {
      "calculate": "datum.area_mha / datum.from_total_mha * 100",
      "as": "row_share_pct"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 3,
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "to_family",
          "type": "nominal",
          "sort": [
            "Rainforest",
            "Eucalypt forest & woodland",
            "Acacia",
            "Other forest & woodland",
            "Shrubland",
            "Grassland",
            "Other native vegetation",
            "Modified / non-native"
          ],
          "title": "Extant vegetation family",
          "axis": {
            "labelAngle": -30,
            "labelLimit": 170,
            "labelPadding": 8
          }
        },
        "y": {
          "field": "from_family",
          "type": "nominal",
          "sort": [
            "Rainforest",
            "Eucalypt forest & woodland",
            "Acacia",
            "Other forest & woodland",
            "Shrubland",
            "Grassland",
            "Other native vegetation"
          ],
          "title": "Estimated pre-1750 vegetation family",
          "axis": {
            "labelLimit": 210,
            "labelPadding": 8
          }
        },
        "color": {
          "field": "row_share_pct",
          "type": "quantitative",
          "title": "Share of historical family (%)",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              "#F3F1E9",
              "#B8CBAF",
              "#5E9470",
              "#174C3A"
            ]
          },
          "legend": {
            "gradientLength": 180
          }
        },
        "tooltip": [
          {
            "field": "from_family",
            "title": "Pre-1750 family"
          },
          {
            "field": "to_family",
            "title": "Extant family"
          },
          {
            "field": "area_mha",
            "type": "quantitative",
            "title": "Matched area (Mha)",
            "format": ".2f"
          },
          {
            "field": "row_share_pct",
            "type": "quantitative",
            "title": "Share of historical family",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.row_share_pct >= 4"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "to_family",
          "type": "nominal",
          "sort": [
            "Rainforest",
            "Eucalypt forest & woodland",
            "Acacia",
            "Other forest & woodland",
            "Shrubland",
            "Grassland",
            "Other native vegetation",
            "Modified / non-native"
          ]
        },
        "y": {
          "field": "from_family",
          "type": "nominal",
          "sort": [
            "Rainforest",
            "Eucalypt forest & woodland",
            "Acacia",
            "Other forest & woodland",
            "Shrubland",
            "Grassland",
            "Other native vegetation"
          ]
        },
        "text": {
          "field": "row_share_pct",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "condition": {
            "test": "datum.row_share_pct >= 45",
            "value": "#FFFFFF"
          },
          "value": "#173D2E"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#334B40",
      "titleColor": "#173D2E",
      "grid": false
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#334B40",
      "titleColor": "#173D2E"
    }
  }
}