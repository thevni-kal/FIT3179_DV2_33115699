{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": 760,
  "height": {
    "step": 25
  },
  "data": {
    "url": "data/nvis_mvg_change.csv"
  },
  "transform": [
    {
      "calculate": "-datum.pre1750_mha",
      "as": "pre_negative"
    }
  ],
  "encoding": {
    "y": {
      "field": "mvg_name",
      "type": "nominal",
      "sort": {
        "field": "pre1750_mha",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelLimit": 210,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "color": "#D7B873"
      },
      "encoding": {
        "x": {
          "field": "pre_negative",
          "type": "quantitative",
          "title": "Mapped area (million hectares)",
          "scale": {
            "domain": [
              -145,
              145
            ]
          }
        },
        "tooltip": [
          {
            "field": "mvg_name",
            "title": "Major Vegetation Group"
          },
          {
            "field": "pre1750_mha",
            "type": "quantitative",
            "title": "Pre-1750 (Mha)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "color": "#2F6D55"
      },
      "encoding": {
        "x": {
          "field": "extant_mha",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "mvg_name",
            "title": "Major Vegetation Group"
          },
          {
            "field": "extant_mha",
            "type": "quantitative",
            "title": "Extant (Mha)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#173F30",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#29483B",
      "titleColor": "#29483B",
      "gridColor": "#E7EAE5",
      "domain": false
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#29483B",
      "titleColor": "#29483B"
    },
    "view": {
      "stroke": null
    }
  }
}