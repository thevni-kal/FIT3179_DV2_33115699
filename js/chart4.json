{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Heatmap showing how the 12 largest national forest types contribute to forest area across Australian states and territories.",
  "background": null,
  "width": 650,
  "height": 455,
  "data": {
    "url": "data/chart4_state_type_heatmap_from_abares.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "STATE",
          "type": "nominal",
          "sort": [
            "WA",
            "NT",
            "SA",
            "Qld",
            "NSW",
            "Vic",
            "Tas",
            "ACT"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFont": "DM Sans",
            "labelFontSize": 12,
            "labelFontWeight": 700,
            "labelColor": "#314B40",
            "labelPadding": 8,
            "domain": false,
            "ticks": false,
            "labelLimit": 260
          }
        },
        "y": {
          "field": "FOR_TYPE",
          "type": "nominal",
          "sort": [
            "Eucalypt Medium Woodland",
            "Eucalypt Medium Open",
            "Acacia",
            "Eucalypt Mallee Woodland",
            "Eucalypt Low Woodland",
            "Melaleuca",
            "Other native forest",
            "Eucalypt Tall Open",
            "Rainforest",
            "Eucalypt Tall Woodland",
            "Callitris",
            "Mangrove"
          ],
          "axis": {
            "title": null,
            "labelFont": "DM Sans",
            "labelFontSize": 11,
            "labelColor": "#415A4F",
            "labelLimit": 240,
            "labelPadding": 8,
            "domain": false,
            "ticks": false
          }
        },
        "color": {
          "field": "percent_of_state_forest",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              75
            ],
            "range": [
              "#DDEAD6",
              "#C8DEBD",
              "#A9CC99",
              "#83B573",
              "#5A9956",
              "#347A47",
              "#175F3B",
              "#064B33"
            ]
          },
          "legend": {
            "title": "Share of state forest (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260,
            "gradientThickness": 11,
            "titleFont": "DM Sans",
            "titleFontSize": 10,
            "titleFontWeight": 700,
            "labelFont": "DM Sans",
            "labelFontSize": 9,
            "values": [
              0,
              10,
              20,
              30,
              40,
              50,
              60,
              70
            ],
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "STATE",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "FOR_TYPE",
            "type": "nominal",
            "title": "Forest type"
          },
          {
            "field": "area_mha",
            "type": "quantitative",
            "title": "Mapped area (million ha)",
            "format": ".2f"
          },
          {
            "field": "percent_of_state_forest",
            "type": "quantitative",
            "title": "Share of state forest (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 10,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "STATE",
          "type": "nominal",
          "sort": [
            "WA",
            "NT",
            "SA",
            "Qld",
            "NSW",
            "Vic",
            "Tas",
            "ACT"
          ]
        },
        "y": {
          "field": "FOR_TYPE",
          "type": "nominal",
          "sort": [
            "Eucalypt Medium Woodland",
            "Eucalypt Medium Open",
            "Acacia",
            "Eucalypt Mallee Woodland",
            "Eucalypt Low Woodland",
            "Melaleuca",
            "Other native forest",
            "Eucalypt Tall Open",
            "Rainforest",
            "Eucalypt Tall Woodland",
            "Callitris",
            "Mangrove"
          ]
        },
        "text": {
          "field": "share_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.percent_of_state_forest >= 35",
            "value": "#FFFFFF"
          },
          "value": "#173F30"
        }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    }
  }
}
