{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Ranked bar chart showing the share of each historical vegetation family that remains in the same broad family in the extant NVIS classification.",
  "background": null,
  "width": 760,
  "height": 430,
  "data": {
    "url": "data/forest_family_outcomes_ternary.csv",
    "format": {
      "type": "csv",
      "parse": {
        "same_pct": "number",
        "matched_mha": "number",
        "modified_pct": "number",
        "other_native_pct": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 5,
        "height": 30,
        "color": "#2f6b52"
      },
      "encoding": {
        "y": {
          "field": "from_family",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {
            "labelFont": "DM Sans",
            "labelFontSize": 14,
            "labelColor": "#173d2e",
            "labelLimit": 240,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "same_pct",
          "type": "quantitative",
          "title": "Share remaining in the same broad vegetation family (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "grid": true,
            "gridColor": "#e5e8e2",
            "domain": false,
            "tickColor": "#d6dbd4",
            "labelFont": "DM Sans",
            "labelFontSize": 12,
            "titleFont": "DM Sans",
            "titleFontSize": 13,
            "titleColor": "#173d2e",
            "labelExpr": "datum.value + '%'"
          }
        },
        "tooltip": [
          {
            "field": "from_family",
            "type": "nominal",
            "title": "Historical family"
          },
          {
            "field": "same_pct",
            "type": "quantitative",
            "title": "Same broad family",
            "format": ".1f"
          },
          {
            "field": "other_native_pct",
            "type": "quantitative",
            "title": "Other native family",
            "format": ".1f"
          },
          {
            "field": "modified_pct",
            "type": "quantitative",
            "title": "Modified / non-native",
            "format": ".1f"
          },
          {
            "field": "matched_mha",
            "type": "quantitative",
            "title": "Matched area (Mha)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "font": "DM Sans",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#173d2e"
      },
      "encoding": {
        "y": {
          "field": "from_family",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "same_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "same_pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#425f54",
      "titleColor": "#173d2e"
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    }
  }
}