{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Connected dot comparison of same-family continuity versus modified/non-native share",
  "width": 670,
  "height": 350,
  "data": {
    "url": "data/chart14_selected_outcomes_from_nvis.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "stroke": "#ABB8B4",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "family",
          "type": "nominal",
          "sort": [
            "Rainforest",
            "Eucalypt forest & woodland",
            "Acacia",
            "Other forest & woodland"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 15,
            "labelLimit": 240,
            "labelPadding": 7
          }
        },
        "x": {
          "field": "share_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Share of matched historical area (%)",
            "labelFontSize": 14,
            "titleFontSize": 15,
            "labelLimit": 260,
            "labelPadding": 7
          }
        },
        "detail": {
          "field": "family"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 260,
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "family",
          "type": "nominal",
          "sort": [
            "Rainforest",
            "Eucalypt forest & woodland",
            "Acacia",
            "Other forest & woodland"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 15,
            "labelLimit": 240,
            "labelPadding": 7
          }
        },
        "x": {
          "field": "share_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Share of matched historical area (%)",
            "labelFontSize": 14,
            "titleFontSize": 15,
            "labelLimit": 260,
            "labelPadding": 7
          }
        },
        "color": {
          "field": "outcome",
          "type": "nominal",
          "scale": {
            "domain": [
              "Same broad family",
              "Modified / non-native"
            ],
            "range": [
              "#197A69",
              "#D36B4F"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "labelFontSize": 15,
            "titleFontSize": 16,
            "symbolSize": 160,
            "title": "Extant classification"
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -17,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#173d2e"
      },
      "encoding": {
        "y": {
          "field": "family",
          "type": "nominal",
          "sort": [
            "Rainforest",
            "Eucalypt forest & woodland",
            "Acacia",
            "Other forest & woodland"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 15,
            "labelLimit": 240,
            "labelPadding": 7
          }
        },
        "x": {
          "field": "share_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Share of matched historical area (%)",
            "labelFontSize": 14,
            "titleFontSize": 15,
            "labelLimit": 260,
            "labelPadding": 7
          }
        },
        "text": {
          "field": "share_pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "annotation": "Unshown share = other native family"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 12,
        "fontWeight": 700,
        "align": "left",
        "baseline": "top",
        "color": "#173D2E",
        "stroke": "#FFFFFF",
        "strokeWidth": 3,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "value": 12
        },
        "y": {
          "value": 12
        },
        "text": {
          "field": "annotation",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "DM Sans",
    "axis": {
      "gridColor": "#e8ece9",
      "labelLimit": 260,
      "labelPadding": 7
    }
  }
}
